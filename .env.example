# =============================================================================
# Finance-AI — variáveis de ambiente (template)
# Copie para `.env` e preencha. NUNCA commite o `.env` real.
# Rotacione todas as chaves antes de operar em produção.
# =============================================================================

# Ambiente: development | test | production
NODE_ENV=development

# --- Banco de dados (Neon / PostgreSQL) -------------------------------------
# DATABASE_URL: connection string "pooled" (host com sufixo "-pooler"), usada
#   pela aplicação em runtime (serverless-friendly).
# DIRECT_URL: conexão direta (sem pooler), usada pelas migrações do Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# --- Autenticação (Clerk) ---------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# --- URL pública da aplicação -----------------------------------------------
# Em desenvolvimento: http://localhost:3000
# Em produção: https://seudominio.com.br
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Pagamentos (Stripe) ----------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PREMIUM_PLAN_PRICE_ID="price_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
NEXT_PUBLIC_STRIPE_CUSTOMER_PORTAL_URL="https://billing.stripe.com/p/login/..."

# --- IA (OpenAI) ------------------------------------------------------------
# Opcional: sem a chave, o relatório de IA retorna um conteúdo de demonstração.
OPENAI_API_KEY="sk-..."

# --- Rate limiting (Upstash Redis) ------------------------------------------
# Necessárias para o rate limiting / cota de IA / cache de relatórios.
UPSTASH_REDIS_REST_URL="https://....upstash.io"
UPSTASH_REDIS_REST_TOKEN="..."
