{
  "name": "finance-ai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "postinstall": "prisma generate || echo 'Prisma generate skipped'",
    "dev": "next dev --turbo",
    "dev:full": "pnpm healthcheck && next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "prepare": "husky",
    "healthcheck": "prisma validate && prisma generate",
    "setup": "pnpm install && pnpm prisma generate && pnpm prisma migrate dev",
    "reset": "rm -rf node_modules pnpm-lock.yaml && pnpm install && pnpm prisma generate"
  },
  "dependencies": {
    "@ai-sdk/google": "3.0.34",
    "@ai-sdk/openai": "3.0.33",
    "@clerk/nextjs": "^6.0.0",
    "@clerk/themes": "^2.1.37",
    "@hookform/resolvers": "^3.9.1",
    "@prisma/adapter-pg": "7.4.0",
    "@prisma/client": "7.4.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-scroll-area": "^1.2.1",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@stripe/stripe-js": "^4.9.0",
    "@tanstack/react-table": "^8.20.5",
    "ai": "6.0.100",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "dotenv": "^17.3.1",
    "lucide-react": "^0.479.0",
    "next": "^16.2.3",
    "pg": "^8.20.0",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.2",
    "react-markdown": "^9.0.1",
    "react-number-format": "^5.4.2",
    "recharts": "^2.15.0",
    "stripe": "^17.3.1",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@types/node": "24",
    "@types/pg": "^8.18.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "git-commit-msg-linter": "^5.0.8",
    "globals": "^17.3.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.5.0",
    "postcss": "^8",
    "prettier": "3.8.1",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "prisma": "7.4.0",
    "tailwindcss": "^3.4.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.56.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@clerk/shared",
      "@prisma/engines",
      "git-commit-msg-linter",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
